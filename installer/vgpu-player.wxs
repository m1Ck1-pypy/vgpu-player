<?xml version="1.0" encoding="UTF-8" ?>
<!-- Build from the repository root:
       .tools\wix\candle.exe -arch x64 -dSourceDir=dist\vgpu-player -o target\wix\ installer\vgpu-player.wxs installer\AppFiles.wxs
       .tools\wix\light.exe -ext .tools\wix\WixUIExtension.dll -pdbout target\wix\vgpu-player.wixpdb -o dist\vgpu-player-<version>.msi target\wix\vgpu-player.wixobj target\wix\AppFiles.wixobj
       (the version comes from Cargo.toml, see `just installer-msi`)
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product
        Id="*"
        Name="VGPU Player"
        Language="1033"
        Version="0.3.2"
        Manufacturer="VGPU Player"
        UpgradeCode="{C2D7A4F0-5B8E-4A31-9C6D-3F1E8B2A7D90}"
    >
        <Package
            InstallerVersion="500"
            Compressed="yes"
            InstallScope="perUser"
            Platform="x64"
        />

        <MajorUpgrade
            DowngradeErrorMessage="A newer version of VGPU Player is already installed."
        />
        <MediaTemplate EmbedCab="yes" />

        <Icon Id="AppIcon" SourceFile="assets\app-icon.ico" />
        <Property Id="ARPPRODUCTICON" Value="AppIcon" />

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="LocalAppDataFolder">
                <Directory Id="INSTALLFOLDER" Name="vgpu-player" />
            </Directory>
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="VGPU Player" />
            </Directory>
        </Directory>

        <DirectoryRef Id="ApplicationProgramsFolder">
            <Component
                Id="StartMenuShortcut"
                Guid="{6A1E3C8B-2F47-4D95-B8A0-1C5E7D9F2A31}"
            >
                <Shortcut
                    Id="StartMenuShortcut"
                    Name="VGPU Player"
                    Target="[INSTALLFOLDER]vgpu.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon"
                />
                <RemoveFolder
                    Id="RemoveApplicationProgramsFolder"
                    On="uninstall"
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\vgpu-player"
                    Name="StartMenuShortcut"
                    Type="integer"
                    Value="1"
                    KeyPath="yes"
                />
            </Component>
        </DirectoryRef>

        <DirectoryRef Id="INSTALLFOLDER">
            <!-- File associations, per user (HKCU), no admin rights needed. Two
                 ProgIDs let Windows remember "Always use this app": video and
                 audio files get separate type names, the command is the same. -->
            <Component
                Id="FileAssociations"
                Guid="{9F5A2C7B-1E48-4D63-A0B9-4C7D2E8F1B35}"
            >
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\VGPUPlayer.Video"
                    Type="string"
                    Value="VGPU Player video"
                    KeyPath="yes"
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\VGPUPlayer.Video\DefaultIcon"
                    Type="string"
                    Value="&quot;[INSTALLFOLDER]vgpu.exe&quot;,0"
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\VGPUPlayer.Video\shell\open\command"
                    Type="string"
                    Value="&quot;[INSTALLFOLDER]vgpu.exe&quot; &quot;%1&quot;"
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\VGPUPlayer.Audio"
                    Type="string"
                    Value="VGPU Player audio"
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\VGPUPlayer.Audio\DefaultIcon"
                    Type="string"
                    Value="&quot;[INSTALLFOLDER]vgpu.exe&quot;,0"
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\VGPUPlayer.Audio\shell\open\command"
                    Type="string"
                    Value="&quot;[INSTALLFOLDER]vgpu.exe&quot; &quot;%1&quot;"
                />

                <!-- The application itself, visible in the "Open with" list. -->
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe"
                    Name="FriendlyAppName"
                    Type="string"
                    Value="VGPU Player"
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\DefaultIcon"
                    Type="string"
                    Value="&quot;[INSTALLFOLDER]vgpu.exe&quot;,0"
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\shell\open\command"
                    Type="string"
                    Value="&quot;[INSTALLFOLDER]vgpu.exe&quot; &quot;%1&quot;"
                />

                <!-- Same extension lists as installer\vgpu-player.iss. -->
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".mp4"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".m4v"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".mov"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".mkv"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".webm"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".ogv"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".avi"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".ts"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".m2ts"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".mts"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".mpg"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".mpeg"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".flv"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".wmv"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".3gp"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".3g2"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".mp3"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".m4a"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".m4b"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".mp2"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".aac"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".flac"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".wav"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".ogg"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".oga"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".opus"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".wma"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".ac3"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe\SupportedTypes"
                    Name=".dts"
                    Type="string"
                    Value=""
                />

                <!-- OpenWithProgids is what the "Always use this app" checkbox
                     writes UserChoice for. Only our values are removed on
                     uninstall; foreign associations stay untouched. -->
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\.mp4\OpenWithProgids"
                    Name="VGPUPlayer.Video"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\.m4v\OpenWithProgids"
                    Name="VGPUPlayer.Video"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\.mov\OpenWithProgids"
                    Name="VGPUPlayer.Video"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\.mkv\OpenWithProgids"
                    Name="VGPUPlayer.Video"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\.webm\OpenWithProgids"
                    Name="VGPUPlayer.Video"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\.ogv\OpenWithProgids"
                    Name="VGPUPlayer.Video"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\.avi\OpenWithProgids"
                    Name="VGPUPlayer.Video"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\.ts\OpenWithProgids"
                    Name="VGPUPlayer.Video"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\.m2ts\OpenWithProgids"
                    Name="VGPUPlayer.Video"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\.mts\OpenWithProgids"
                    Name="VGPUPlayer.Video"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\.mpg\OpenWithProgids"
                    Name="VGPUPlayer.Video"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\.mpeg\OpenWithProgids"
                    Name="VGPUPlayer.Video"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\.flv\OpenWithProgids"
                    Name="VGPUPlayer.Video"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\.wmv\OpenWithProgids"
                    Name="VGPUPlayer.Video"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\.3gp\OpenWithProgids"
                    Name="VGPUPlayer.Video"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\.3g2\OpenWithProgids"
                    Name="VGPUPlayer.Video"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\.mp3\OpenWithProgids"
                    Name="VGPUPlayer.Audio"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\.m4a\OpenWithProgids"
                    Name="VGPUPlayer.Audio"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\.m4b\OpenWithProgids"
                    Name="VGPUPlayer.Audio"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\.mp2\OpenWithProgids"
                    Name="VGPUPlayer.Audio"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\.aac\OpenWithProgids"
                    Name="VGPUPlayer.Audio"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\.flac\OpenWithProgids"
                    Name="VGPUPlayer.Audio"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\.wav\OpenWithProgids"
                    Name="VGPUPlayer.Audio"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\.ogg\OpenWithProgids"
                    Name="VGPUPlayer.Audio"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\.oga\OpenWithProgids"
                    Name="VGPUPlayer.Audio"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\.opus\OpenWithProgids"
                    Name="VGPUPlayer.Audio"
