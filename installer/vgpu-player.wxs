                    Name="VGPUPlayer.Audio"
                    Type="string"
                    Value=""
                />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\Classes\.dts\OpenWithProgids"
                    Name="VGPUPlayer.Audio"
                    Type="string"
                    Value=""
                />

                <RemoveRegistryKey
                    Root="HKCU"
                    Key="Software\Classes\VGPUPlayer.Video"
                    Action="removeOnUninstall"
                />
                <RemoveRegistryKey
                    Root="HKCU"
                    Key="Software\Classes\VGPUPlayer.Audio"
                    Action="removeOnUninstall"
                />
                <RemoveRegistryKey
                    Root="HKCU"
                    Key="Software\Classes\Applications\vgpu.exe"
                    Action="removeOnUninstall"
                />
            </Component>
        </DirectoryRef>

        <Feature Id="MainFeature" Title="VGPU Player" Level="1">
            <ComponentGroupRef Id="AppFiles" />
            <ComponentRef Id="StartMenuShortcut" />
            <ComponentRef Id="FileAssociations" />
        </Feature>

        <UIRef Id="WixUI_Minimal" />
    </Product>
</Wix>
